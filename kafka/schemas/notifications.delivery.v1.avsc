{
  "type": "record",
  "name": "NotificationDelivery",
  "namespace": "aurum.notifications",
  "doc": "Emitted after an individual channel delivery attempt completes.",
  "fields": [
    {"name": "id", "type": "string", "doc": "Delivery record identifier."},
    {"name": "dispatch_id", "type": "string", "doc": "Source dispatch event identifier."},
    {"name": "tenant_id", "type": "string"},
    {"name": "recipient_id", "type": "string"},
    {"name": "channel", "type": "string"},
    {"name": "status", "type": {"type": "enum", "name": "DeliveryStatus", "symbols": ["queued", "sent", "delivered", "failed", "deferred", "suppressed"]}},
    {"name": "attempt", "type": "int", "doc": "Attempt number starting at 1."},
    {"name": "provider_message_id", "type": ["null", "string"], "default": null},
    {"name": "error_code", "type": ["null", "string"], "default": null},
    {"name": "error_message", "type": ["null", "string"], "default": null},
    {"name": "queued_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "completed_at", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null},
    {"name": "metadata", "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
