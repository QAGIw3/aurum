FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_NO_CACHE_DIR=on

WORKDIR /app

# System dependencies often needed for optional wheels
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       curl \
       git \
       libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy minimal files to resolve dependencies
COPY pyproject.toml ./

RUN python -m pip install --upgrade pip \
    && pip install -e .[test,quality]

# The tests, src, and config are volume-mounted by docker-compose.e2e.yml
CMD ["pytest", "-q"]


